# Copy to deploy/.env on the VM (setup.sh does it and fills the secrets in).
# deploy/.env holds secrets: it is git-ignored and never leaves the VM.

# The public address, without https://. sslip.io turns an IP into a name
# that resolves back to it, e.g. 34-100-1-2.sslip.io for 34.100.1.2.
SITE_ADDRESS=

GOOGLE_CLOUD_PROJECT=smart-resume-analyzer-a7x2

# Accounts with these emails become ADMIN when they register or sign in.
APP_ADMIN_EMAILS=
# The secret path the admin API and console live under (never /admin).
# 24-64 letters, digits, - or _. Generated by setup.sh; keep it private.
APP_ADMIN_PATH=
# Bug reports: approving one opens a GitHub issue. A fine-grained token with
# Issues: read and write on this repository only. Empty = approving is off.
GITHUB_ISSUES_TOKEN=

# Random secrets, generated by setup.sh.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=coverlay
MINIO_ROOT_PASSWORD=
JWT_SECRET=
