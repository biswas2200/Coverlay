# Which LLM provider llm_client.py uses for the AI engine (profile extraction
# for every domain, and the coaching narrative): "gemini" (default), "groq",
# or "none" -- no provider is ever built, and every analysis comes back
# locked with lock_reason "ai_unavailable" (ATS score and a rules-only
# profile card, no role matches). The local NER model is archived
# (archive/ner_model/README.md).
LLM_PROVIDER=gemini

# Gemini on Vertex AI -- authenticated with Google Application Default
# Credentials (ADC). There is NO API key to set. One-time setup:
#
#   gcloud auth application-default login      # on a dev machine
#   gcloud config set project <your-project>   # optional convenience
#
# On GCP (Compute Engine / Cloud Run / GKE) the attached service account is
# the credential -- give it the "Vertex AI User" role and set nothing else.
# The two variable names below are the ones gcloud and the google-genai SDK
# already understand, so exporting them in your shell works too.
GOOGLE_CLOUD_PROJECT=
# "global" = Vertex AI's multi-region Gemini endpoint; or a region such as
# asia-south1 / us-central1 to pin traffic.
GOOGLE_CLOUD_LOCATION=global
# One Gemini model per kind of task. An empty tier runs on GEMINI_MODEL.
#   extract -- reading a resume into JSON
#   chat    -- Lay AI messages and the analysis narrative
#   write   -- tailored resumes, cover letters, cold emails
# gemini-2.5-flash-lite (the old default) was retired on Vertex AI in October
# 2026. Prices and thinking levels per model are in
# app/services/model_catalog.py; scripts/llm_cost_check.py measures a run.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_EXTRACT=
GEMINI_MODEL_CHAT=
GEMINI_MODEL_WRITE=gemini-3.8-flash
# Thinking budget for models that take one (Gemini 2.5). 0 = off (default:
# thinking tokens are billed as output, the expensive side). -1 = send
# nothing, leave the model's dynamic default. Gemini 3.x models take a
# thinking level instead, set per model in app/services/model_catalog.py.
GEMINI_THINKING_BUDGET=0

# --- LLM cost controls (apply to whichever provider is selected) ---
# Resume text is whitespace-compacted and cut to this many characters
# before the extraction prompt (~4 chars/token). Two pages is 3-6k chars.
LLM_MAX_INPUT_CHARS=16000
# Output ceilings per task (you pay only for what is generated; these stop
# a runaway answer). The narrative prompt itself asks for <=180 words.
LLM_EXTRACT_MAX_OUTPUT_TOKENS=3072
LLM_NARRATE_MAX_OUTPUT_TOKENS=600
# In-process completion cache: an unchanged resume re-analysed costs nothing
# the second time. 0 disables.
LLM_CACHE_SIZE=256
# Prices used to estimate spend (GET /llm-usage, AnalyzeResponse.llm_usage).
# Each Gemini model's list price is in app/services/model_catalog.py;
# LLM_PRICES overrides one as JSON, e.g. 3.8 Flash's introductory price
# (until 31 Dec 2026):
#   LLM_PRICES={"gemini-3.8-flash": [0.75, 3.75]}
# The two below price any model the catalog doesn't list (a Groq model, a
# new Gemini). Estimates only -- check the Cloud Billing report.
LLM_PRICES={}
LLM_INPUT_USD_PER_1M=0.30
LLM_OUTPUT_USD_PER_1M=2.50
# Soft daily cap (estimated USD, UTC day) on what the service may spend on
# the AI engine; past it, analyses come back locked ("ai_budget_exhausted")
# until tomorrow. In-process only -- a brake, not billing. 0 = off.
LLM_DAILY_BUDGET_USD=0

# Groq -- optional alternative provider (LLM_PROVIDER=groq). Hosts multiple
# open-weight model families (Llama, Gemma, ...) behind one API; switching
# families is just changing GROQ_MODEL. Check
# https://console.groq.com/docs/models for current model ids before picking
# one -- Groq deprecates/replaces models over time. Key from
# https://console.groq.com, read from the environment only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# sentence-transformers model used for skill/role embedding similarity
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Commit the embedding model is pinned to (hashed into engine_fingerprint).
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# Logging (see README "Logging"): level for the app's loggers, and an
# optional rotating log file. Empty LOG_FILE logs to the console only.
LOG_LEVEL=INFO
LOG_FILE=
