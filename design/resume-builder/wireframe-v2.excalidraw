      "text": "How Lay AI works here",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "How Lay AI works here",
      "lineHeight": 1.25
    },
    {
      "id": "ntB",
      "type": "text",
      "x": 60,
      "y": 518,
      "width": 360.03277587890625,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1558703734,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793716971168,
      "link": null,
      "locked": false,
      "text": "- The panel starts closed; the Lay AI\n  button opens it, X closes it.\n- Chat: ask for a change; the resume\n  updates and the changed parts turn green.\n- Every change is a version (you, Lay AI,\n  template, restore); restore any of them.\n- Typing yourself costs no AI call: the\n  pointer is animation only. Lay AI reads\n  the latest resume when you next chat.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 174,
      "containerId": null,
      "originalText": "- The panel starts closed; the Lay AI\n  button opens it, X closes it.\n- Chat: ask for a change; the resume\n  updates and the changed parts turn green.\n- Every change is a version (you, Lay AI,\n  template, restore); restore any of them.\n- Typing yourself costs no AI call: the\n  pointer is animation only. Lay AI reads\n  the latest resume when you next chat.",
      "lineHeight": 1.25
    },
